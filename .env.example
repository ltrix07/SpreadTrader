# ============================================================
# SpreadTrader — Live Trading Configuration
# ============================================================
# Copy to .env and fill in API keys to start live trading.
# ============================================================

APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///data/spread_arb.sqlite3

# --- Exchanges & Symbols ---
EXCHANGES=binance,okx,bybit,bitget,mexc
MARKET_TYPE=perp
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,APTUSDT,ARBUSDT,OPUSDT,SUIUSDT,SEIUSDT,WIFUSDT,INJUSDT,NEARUSDT,ORDIUSDT,1000BONKUSDT,DOTUSDT,UNIUSDT,LDOUSDT,AAVEUSDT,GRTUSDT,TIAUSDT,FETUSDT,PENDLEUSDT,JUPUSDT,ENAUSDT,ONDOUSDT,ZKUSDT,STRKUSDT,BLURUSDT,GALAUSDT,CFXUSDT,IMXUSDT,GMXUSDT,MASKUSDT,WOOUSDT,ACHUSDT,CELOUSDT,LRCUSDT,SKLUSDT,ZENUSDT

# --- Fees (taker, %) ---
TAKER_FEE_MEXC_PCT=0.05
TAKER_FEE_BYBIT_PCT=0.055
TAKER_FEE_BINANCE_PCT=0.05
TAKER_FEE_OKX_PCT=0.05
TAKER_FEE_BITGET_PCT=0.05

# --- Spread Scanner ---
SLIPPAGE_BUFFER_PCT=0.01
SAFETY_BUFFER_PCT=0.01
POLL_INTERVAL_SEC=1.0
REQUEST_TIMEOUT_SEC=8.0
RECONNECT_BACKOFF_SEC=2.0
TOP_SPREADS_LOG_INTERVAL_SEC=5.0
SPREAD_SCAN_INTERVAL_SEC=0.5

# --- Mean Reversion Strategy ---
MR_ENABLED=true
MR_SIGMA_ENTRY=2.5
MR_SIGMA_STOP=6.0
MR_MIN_STOP_DISTANCE_PCT=0.15
MR_MIN_NET_EDGE_PCT=0.25
MR_TAKE_PROFIT_FRACTION=0.75
MR_NOTIONAL_USDT=10
MR_COMPOUND_ENABLED=true
MR_NOTIONAL_PCT=85
MR_MIN_NOTIONAL_USDT=5
MR_MAX_POSITIONS=1
MR_ROLLING_WINDOW=360
MR_MAX_HOLD_SECONDS=900
MR_COOLDOWN_SEC=120
MR_EXIT_MAX_QUOTE_AGE_MS=30000
MR_EXCLUDED_EXCHANGES=htx
MR_QUOTE_FRESHNESS_WINDOW=30
MR_MIN_QUOTE_FRESHNESS_PCT=80

# --- Live Trading ---
LIVE_TRADING=true
DEFAULT_LEVERAGE=3
ORDER_TIMEOUT_SEC=10.0
MAX_NOTIONAL_USDT=50
BALANCE_SNAPSHOT_INTERVAL_SEC=1800
EXCHANGE_STOP_LOSS_PCT=5.0

# --- API Keys (fill in your keys) ---
API_KEY_BINANCE=
API_SECRET_BINANCE=

API_KEY_OKX=
API_SECRET_OKX=
API_PASSPHRASE_OKX=

API_KEY_BYBIT=
API_SECRET_BYBIT=

API_KEY_BITGET=
API_SECRET_BITGET=
API_PASSPHRASE_BITGET=

API_KEY_MEXC=
API_SECRET_MEXC=
